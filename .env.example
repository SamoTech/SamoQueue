# Copy to .env. Set new, unique values before starting.
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
APP_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
AVAYA_INGEST_KEY=REPLACE_WITH_SEPARATE_RANDOM_64_CHARACTER_KEY
APP_DEMO_MODE=true
APP_TIMEZONE=Africa/Cairo
APP_DB_PATH=./data/queue.db
# Only expose behind HTTPS/reverse proxy in a trusted network.

# Fail-closed: never automatically send operational call-control requests unless explicitly enabled.
AURA_CONTROL_ENABLED=false
# The bridge is separate and uses AVAYA_INGEST_KEY. No AES passwords are stored here.
# Separate high-privilege key: NEVER reuse AVAYA_INGEST_KEY.
AURA_COMMAND_BRIDGE_KEY=REPLACE_WITH_SEPARATE_RANDOM_64_CHARACTER_COMMAND_KEY
