# Copy to .env and replace all placeholders with distinct random secrets.
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
APP_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
APP_REVIEWER_USER=reviewer
APP_REVIEWER_PASSWORD=REPLACE_WITH_SEPARATE_STRONG_REVIEWER_PASSWORD
APP_DEMO_MODE=true
APP_TIMEZONE=Africa/Cairo
APP_DB_PATH=./data/queue.db
# Internal event API: QueuePilot-native SIP process only. Do not expose publicly.
ENGINE_EVENT_KEY=REPLACE_WITH_UNIQUE_RANDOM_64_CHARACTER_EVENT_KEY
# These do NOT by themselves enable recording or live monitoring.
RECORDINGS_ENABLED=false
RECORDING_ENGINE_KEY=REPLACE_WITH_UNIQUE_RANDOM_64_CHARACTER_RECORDING_KEY
RECORDING_DIR=./data/recordings
MONITORING_ENABLED=false
MONITOR_ENGINE_KEY=REPLACE_WITH_UNIQUE_RANDOM_64_CHARACTER_MONITORING_KEY
