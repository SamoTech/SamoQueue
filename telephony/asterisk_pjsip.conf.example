; SECURITY-RESTRICTED EXAMPLE - replace all 192.0.2.0/24 documentation IPs.
; Put a managed SBC in front of Asterisk; configure proper TLS certs and firewall ACLs.
; Do NOT expose SIP, ARI or RTP directly to the public Internet.
; Asterisk PJSIP objects below assume the system's transport is separately configured.
[avaya-queuepilot]
type=endpoint
context=from-avaya-queuepilot
disallow=all
allow=alaw,ulaw
direct_media=no
; Configure transport=transport-tls only after TLS listener and trust are set up.
; transport=transport-tls

[avaya-queuepilot-identify]
type=identify
endpoint=avaya-queuepilot
match=192.0.2.10/32

; Agent WebRTC accounts must be provisioned individually with strong credentials,
; WSS/TLS, DTLS-SRTP and ICE as documented in Asterisk's WebRTC guide.
; Never reuse a shared SIP password or enable anonymous registrations.
